{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.+__create_plan",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stele-capture-plan.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stele-wait-approval.mjs",
            "timeout": 1200
          }
        ]
      }
    ]
  }
}
